internal class Program
{
    static void Main(string[] args)
    {
        int[] arr = [0,1,1,2,3,6,8,10,23,38,55,89,199,233,377,638];
        int L = arr[0];
        int H = arr.Count() - 1;
        int M = (L+H)/2;
        bool found = false;

        int LinearSearch(int h, int l, int num, int[] a)
        {
            Console.WriteLine(a[3]);
            while (true)
            {
                int pointer = (h + l) / 2;

                if (num == a[pointer])
                {
                    return pointer;
                }
                else if (num < a[pointer])
                {
                    l = pointer + 1;
                }
                else if (num > a[pointer])
                {
                    h = pointer - 1;
                }
            }
        }
        Console.Write($"Enter value of n: ");
        int n = int.Parse(Console.ReadLine());
        while (found != true)
        {
            for (int i = 3; i < arr.Count() - 1; i += 4)
            {
                Console.WriteLine($"Iteration {i}");
                if (arr[i] == n)
                {
                    found = true;
                    Console.WriteLine($"{n} is the {i} term in the array");
                }
                else if (arr[i] < n)
                {
                    L = i - 3;
                    H = i - 1;
                    Console.WriteLine($"{n} is the {LinearSearch(H, L, n, arr)} term in the array");
                }
                else
                {
                    Console.WriteLine($"{n} is not smaller than the {i} term");
                }
            }
        }
        Console.ReadKey();
    }
}
