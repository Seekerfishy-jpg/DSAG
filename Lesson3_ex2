using System.Diagnostics.Tracing;
using System.IO;

class Student
{
    public string strName;
    public string strCourse;
    public int intScore;

    public Student(string n, string c, int s)
    { 
        strName = n;
        strCourse = c;
        intScore = s;
    }

}
class Program
{
    static void Main(string[] args)
    {
        
        string[] line = File.ReadAllLines(@"C:\Users\Evanl\OneDrive\Desktop\DSAG\Lesson 3\Lesson3_ex2\Lesson3_Ex2_data.txt");
        int finish_count = 0;
        bool finish = false;
        int number = line.Count();
        Student[] student = new Student[number];
        for (int i = 0;i< line.Count(); i++)
        { 
            string[] word = line[i].Split(",");
            student[i] = new Student(word[0], word[1], int.Parse(word[2]));
        }
        while (finish == false)
        {
            finish = true;
            for (int f = 0; f < number - 1; f++)
            {
                if (student[f].intScore > student[f + 1].intScore)
                {
                    int newscore1 = student[f].intScore;
                    student[f].intScore = student[f + 1].intScore;
                    student[f + 1].intScore = newscore1;
                }
                else if (student[(number - 1) - f].intScore < student[(number - 1) - (f + 1)].intScore)
                {
                    int newscore2 = student[(number - 1) - f].intScore;
                    student[(number - 1) - f].intScore = student[(number - 1) - (f + 1)].intScore;
                    student[(number - f - 2)].intScore = newscore2;
                }
                else
                {
                    finish = false;
                }
                Console.WriteLine(student[f].intScore);
                finish_count++;
            }
        }
        Console.WriteLine();
        Console.WriteLine($"it took {finish_count} interations to complete");

           
     
    }
}
